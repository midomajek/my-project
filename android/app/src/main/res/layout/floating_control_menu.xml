<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_panel"
    android:padding="6dp"
    android:elevation="8dp">

    <!-- Play / Pause Button -->
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:selectableItemBackgroundBorderless"
        android:src="@drawable/ic_play"
        android:contentDescription="Play or Pause"
        android:tint="#10B981" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginVertical="4dp" />

    <!-- Add Point (+) -->
    <ImageButton
        android:id="@+id/btn_add_point"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:selectableItemBackgroundBorderless"
        android:src="@drawable/ic_add"
        android:contentDescription="Add Point"
        android:tint="#38BDF8" />

    <!-- Remove Point (-) -->
    <ImageButton
        android:id="@+id/btn_remove_point"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:selectableItemBackgroundBorderless"
        android:src="@drawable/ic_remove"
        android:contentDescription="Remove Point"
        android:tint="#F59E0B" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginVertical="4dp" />

    <!-- Close Widget (X) -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="Close"
        android:tint="#EF4444" />

</LinearLayout>
